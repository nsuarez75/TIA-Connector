<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Openness de TIA Portal V19 solo funciona en .NET Framework 4.8, 64 bits -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TiaConnector.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaConnector.Contracts\TiaConnector.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <!-- No se copia: el puente la carga de la instalación de TIA V19 al arrancar (OpennessAssemblies) -->
      <HintPath>$(SiemensEngineeringPath)</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
