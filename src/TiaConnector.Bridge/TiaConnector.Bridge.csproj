<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- El puente: proceso .NET Framework 4.8 de 64 bits que habla con TIA (Openness V19). El cliente lo lleva dentro -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TiaConnector.Bridge</RootNamespace>
    <AssemblyName>TiaConnector.Bridge</AssemblyName>
    <!-- Se genera el .exe.config, pero el cliente solo reparte el .exe: Costura resuelve las versiones de las
         librerías que lleva dentro aunque falte el .config (lo comprueban las pruebas con el puente extraído) -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaConnector.Contracts\TiaConnector.Contracts.csproj" />
    <ProjectReference Include="..\TiaConnector.Core\TiaConnector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Un único .exe con las librerías dentro (Siemens.Engineering no: se carga de la instalación de TIA) -->
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>$(SiemensEngineeringPath)</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
