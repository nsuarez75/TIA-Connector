<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Una sola versión para todo: el cliente solo habla con un puente de su misma versión de protocolo -->
    <Version>0.1.0</Version>
    <Authors>Ignacio Suarez</Authors>
    <Product>TIA-Connector</Product>
    <Copyright>Copyright (c) 2026 Ignacio Suarez</Copyright>
    <!-- Ruta estándar de Openness V19; el puente la carga de donde diga el registro (ver OpennessAssemblies) -->
    <SiemensEngineeringPath>C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19\Siemens.Engineering.dll</SiemensEngineeringPath>
  </PropertyGroup>
</Project>
